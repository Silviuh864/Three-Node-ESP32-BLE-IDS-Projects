#include <stdio.h>
#include <string.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "esp_wifi.h"
#include "esp_mac.h"
#include "nvs_flash.h"
#include "esp_now.h"

typedef struct {
    uint8_t tip;
    char Nod[8];
    bool start;
} __attribute__((packed)) esp_now_start_nod;

typedef struct {
    uint8_t tip;
    char Nod[8];
    bool calib;
} __attribute__((packed)) esp_now_calib_nod;
typedef struct struct_localizare{
    uint8_t tip;
    char Nod[8];
    float dist;
}__attribute__((packed)) esp_now_dist;
typedef struct struct_alerta{
    uint8_t tip;
    char Nod[8];
    uint8_t Mac[6];
}__attribute__((packed)) esp_now_alerta;


char mesaj_calib[] = "Calibrat";
char mesaj_start[] = "Start";
char mesaj_fail[]  = "Fail";
char mesaj_alerta[]="Alerta";

void afiseaza_si_trimite_mac() {
    uint8_t mac[6];
    esp_read_mac(mac, ESP_MAC_WIFI_STA);
    printf("MAC %02X:%02X:%02X:%02X:%02X:%02X\n",
           mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
}

void OnDataRecv(const esp_now_recv_info_t *info, const uint8_t *data, int len) {
    if (len < 1) return;

    uint8_t tip_mesaj = data[0];

    if (tip_mesaj == 0) {
        if (len < sizeof(esp_now_start_nod)) {
            printf("[EROARE] Mesaj tip 0 prea scurt: %d bytes\n", len);
            return;
        }
        esp_now_start_nod *m = (esp_now_start_nod*)data;
        printf("0|%s|STATUS:%s\n", m->Nod, m->start ? "START" : "FAIL");
    }
    else if (tip_mesaj == 1) {
        if (len < sizeof(esp_now_calib_nod)) {
            printf("[EROARE] Mesaj tip 1 prea scurt: %d bytes\n", len);
            return;
        }
        esp_now_calib_nod *m = (esp_now_calib_nod*)data;
         printf("1|%s|STATUS:%s\n", m->Nod, m->calib ? "CALIBRAT" : "FAIL");
    }
    else if(tip_mesaj==2){
         if (len < sizeof(esp_now_dist)) {
            printf("[EROARE] Mesaj tip 2 prea scurt: %d bytes\n", len);
            return;
        }
        esp_now_dist *m = (esp_now_dist*)data;
        printf("2|%s|DIST:%.2f\n", m->Nod, m->dist);
    }
    else if(tip_mesaj==3){
        if(len<sizeof(esp_now_alerta)){
            printf("[EROARE] Mesaj tip 3 prea scurt: %d bytes\n", len);
            return;
        }
        esp_now_alerta *m=(esp_now_alerta*)data;
        printf("3|%s|MAC:%02X:%02X:%02X:%02X:%02X:%02X\n",
           m->Nod,
           m->Mac[0], m->Mac[1], m->Mac[2],
           m->Mac[3], m->Mac[4], m->Mac[5]);
    }
    else {
        printf("[EROARE] Tip mesaj necunoscut: %d\n", tip_mesaj);
    }
}

void monitor_serial_task(void *pvParameters) {
    char c;
    while(1) {
        if (scanf("%c", &c) != EOF) {
            afiseaza_si_trimite_mac();
        }
        vTaskDelay(pdMS_TO_TICKS(100));
    }
}

void app_main(void) {
    esp_err_t ret = nvs_flash_init();
    if (ret == ESP_ERR_NVS_NO_FREE_PAGES || ret == ESP_ERR_NVS_NEW_VERSION_FOUND) {
        ESP_ERROR_CHECK(nvs_flash_erase());
        ret = nvs_flash_init();
    }
    ESP_ERROR_CHECK(ret);

    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
    ESP_ERROR_CHECK(esp_wifi_init(&cfg));
    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
    ESP_ERROR_CHECK(esp_wifi_start());
    ESP_ERROR_CHECK(esp_now_init());
    ESP_ERROR_CHECK(esp_now_register_recv_cb(OnDataRecv));

    xTaskCreate(monitor_serial_task, "monitor_serial", 2048, NULL, 5, NULL);

    while(1) {
        vTaskDelay(pdMS_TO_TICKS(1000));
    }
}
